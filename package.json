{
  "name": "thetooltable",
  "private": true,
  "version": "1.1.1",
  "description": "TheToolTable — a growing set of desktop-grade tools in one ultra-slick 3D animated studio.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0",
    "engine": "node server/standalone.js",
    "setup:engine": "bash scripts/setup-engine.sh",
    "sidecars": "node scripts/fetch-sidecars.mjs",
    "tauri": "tauri",
    "app:win": "tauri build",
    "app:win:sidecars": "node scripts/fetch-sidecars.mjs && tauri build --config src-tauri/tauri.sidecars.conf.json",
    "app:android": "tauri android build --apk --target aarch64 --target armv7"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/urd": "^1.0.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "fix-webm-duration": "^1.0.6",
    "framer-motion": "^11.11.0",
    "gifenc": "^1.0.3",
    "jspdf": "^4.2.1",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.8"
  }
}
