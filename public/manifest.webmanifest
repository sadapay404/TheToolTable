{
  "id": "/",
  "name": "TheToolTable — By Mubashir",
  "short_name": "ToolTable",
  "description": "A private workbench of file tools. Everything is processed on this device — nothing is uploaded.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F0EDE4",
