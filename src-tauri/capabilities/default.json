{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions. yt-dlp arguments are produced only by the app's own audited buildArgs().",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "opener:default",
    "shell:default",
    "notification:default",
    "upload:default",
    "download:default",
    "background-service:default",
    { "identifier": "shell:allow-spawn", "allow": [{ "name": "binaries/yt-dlp", "sidecar": true, "args": true }] },
    { "identifier": "shell:allow-execute", "allow": [
      { "name": "binaries/yt-dlp", "sidecar": true, "args": true },
      { "name": "binaries/ffmpeg", "sidecar": true, "args": ["-version"] }
    ] },
    { "identifier": "fs:allow-mkdir", "allow": [
      { "path": "$DOWNLOAD/TheToolTable" },
      { "path": "$APPCACHE/TheToolTable/**" }
    ] },
    { "identifier": "fs:allow-stat", "allow": [
      { "path": "$DOWNLOAD/TheToolTable/**" },
      { "path": "$APPCACHE/TheToolTable/**" }
    ] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPCACHE/TheToolTable/**" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$APPCACHE/TheToolTable/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPCACHE/TheToolTable/**" }] }
  ]
}
